<li>
    <article class="post-item">
        <h2><a href="{{url}}">{{title}}</a></h2>
        <p class="post-date"><time datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMM YYYY"}}</time></p>
        {{#if @custom.show_excerpts}}<p class="post-item-excerpt">{{excerpt words="30"}}</p>{{/if}}
    </article>
</li>
