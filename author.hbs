{{!< default}}
{{#author}}
<header class="page-header">
    {{#if profile_image}}<img src="{{img_url profile_image size="s"}}" alt="" width="96" height="96">{{/if}}
    <h1>{{name}}</h1>
    {{#if bio}}<p>{{bio}}</p>{{/if}}
    {{#if website}}<p><a href="{{website}}" rel="me">{{website}}</a></p>{{/if}}
    <p>{{plural count.posts empty=(t "No posts") singular=(t "1 post") plural=(t "% posts")}}</p>
</header>
{{/author}}
<ol class="post-list">
    {{#foreach posts}}
    {{> "post-item"}}
    {{/foreach}}
</ol>
{{pagination}}
