{{!< default}}
{{#post}}
<article class="{{post_class}}">
    <header class="post-header">
        <h1>{{title}}</h1>
        {{#if custom_excerpt}}<p class="post-excerpt">{{custom_excerpt}}</p>{{/if}}
        <p class="post-meta">
            {{#if authors}}{{t "By"}} {{authors}} &middot; {{/if}}<time datetime="{{date format="YYYY-MM-DD"}}">{{date format="LL"}}</time>{{#if access}} &middot; {{reading_time minute=(t "1 min read") minutes=(t "% min read")}}{{/if}}
        </p>
        {{#if feature_image}}
        <figure>
            <img src="{{img_url feature_image size="l"}}"
                 srcset="{{img_url feature_image size="s"}} 300w, {{img_url feature_image size="m"}} 600w, {{img_url feature_image size="l"}} 1000w, {{img_url feature_image size="xl"}} 2000w"
                 sizes="(min-width: 1000px) 1000px, 100vw"
                 alt="{{feature_image_alt}}" fetchpriority="high">
            {{#if feature_image_caption}}<figcaption>{{{feature_image_caption}}}</figcaption>{{/if}}
        </figure>
        {{/if}}
    </header>

    <div class="gh-content">
        {{content}}
    </div>

    {{#if tags}}
    <footer class="post-footer">
        <p>{{t "Filed under"}} {{tags}}</p>
    </footer>
    {{/if}}
</article>

{{#if comments}}{{comments}}{{/if}}
{{/post}}
